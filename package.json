{
  "name": "notes-service",
  "version": "1.0.0",
  "description": "Personal Notes Service API",
  "main": "src/server.js",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "nodemon src/server.js",
    "build": "npm install --prefix personal_notes_frontend/personal-notes-frontend && npm run build --prefix personal_notes_frontend/personal-notes-frontend",
    "start": "node src/server.js",
    "start:full": "npm run build && npm start",
    "test:e2e": "playwright test tests/e2e",
    "migrate": "node scripts/migrate_notes_schema.js",
    "migrate:full": "node scripts/migrate_full_schema.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^1.23.0",
    "multer": "^2.2.0",
    "pg": "^8.12.0",
    "validator": "^13.15.35"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "nodemon": "^3.1.4",
    "tar": "^7.5.19"
  }
}
